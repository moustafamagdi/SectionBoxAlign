      </RibbonPanelSource>
    </RibbonPanel>
    <RibbonPanel x:Uid="MMTools.ClashAudit.Panel">
      <RibbonPanelSource x:Uid="MMTools.ClashAudit.Source" Title="Clash Audit" KeyTip="CA">
